# Copy to .env for local development. On Render, set these in the service Environment tab.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=regent_data_platform_prod
WAREHOUSE_STAGING_SCHEMA=moodle_staging
WAREHOUSE_DIM_SCHEMA=moodle_processed
WAREHOUSE_GRADEBOOK_SCHEMA=moodle_processed
PORT=3000
HOST=0.0.0.0
PYTHON_BIN=python3
EXPORT_OUTPUT_DIR=/tmp/gradebook-exports

# Microsoft sign-in (required in production / on Render)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SESSION_SECRET=
BASE_URL=https://your-service.onrender.com
# Comma-separated list of allowed Microsoft accounts (takes priority over domain)
AZURE_ALLOWED_EMAILS=kameel.maharaj@regent.ac.za,zaheera.ganie@regent.ac.za
# Optional: restrict to your organisation email domain when no allowlist is set
AZURE_ALLOWED_DOMAIN=regent.ac.za
# Optional: use "login" to force credential entry every sign-in
AZURE_AUTH_PROMPT=select_account
# Local dev only — set false to skip Microsoft sign-in
AZURE_AUTH_ENABLED=false

# Role-based access: comma-separated emails limited to Full Gradebook Export
# and Intake Summary Report (all other reports stay hidden/blocked)
APP_ROLE_GRADEBOOK_ONLY_EMAILS=
# Admin users: full report access + Export Audit Log page
APP_ROLE_ADMIN_EMAILS=

# Optional: directory for local export audit JSONL (defaults to EXPORT_OUTPUT_DIR/audit).
# Ephemeral on Render — survives process restarts until the next redeploy/rebuild.
AUDIT_LOG_DIR=

# Durable export audit log (Neon Postgres). Preferred: AUDIT_DATABASE_URL or NEON_DATABASE_URL.
# Also accepts DATABASE_URL. Use a Neon connection string with SSL, e.g. ?sslmode=require
# For long-running Express on Render, either the direct or pooled Neon URL works with `pg`.
# Table grab_export_audit is created automatically on startup when this is set.
AUDIT_DATABASE_URL=
# NEON_DATABASE_URL=

